# ─────────────────────────────────────────────
# SECRETS & ENVIRONMENT  (never commit these)
# ─────────────────────────────────────────────
.env
.env.*
*.env
!*.env.example
.envrc
secrets.json
secrets.yaml
secrets.yml
*_secrets.*
*.pem
*.key
*.crt
*.p12
*.pfx
service-account*.json
firebase*.json
google-credentials*.json

# ─────────────────────────────────────────────
# DATABASES  (local dev only — use Supabase in prod)
# ─────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
campusforge.db
nexus.db

# ─────────────────────────────────────────────
# USER UPLOADS  (private documents)
# ─────────────────────────────────────────────
backend/uploads/*
uploads/*
!backend/uploads/.gitkeep
*.pdf
*.docx
*.doc
*.xlsx
*.xls
*.csv

# ─────────────────────────────────────────────
# PYTHON
# ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
*.egg-info/
dist/
build/
eggs/
*.egg
pip-log.txt

# ─────────────────────────────────────────────
# NODE / FRONTEND
# ─────────────────────────────────────────────
node_modules/
frontend/node_modules/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
.cache/
.parcel-cache/
# Keep built dist — needed for single-service Render deploy
# frontend/dist/   ← intentionally NOT ignored

# ─────────────────────────────────────────────
# LOCAL TOOLS & IDEs
# ─────────────────────────────────────────────
.tools/
.vscode/
.idea/
*.swp
*.swo
*~

# ─────────────────────────────────────────────
# OS FILES
# ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

